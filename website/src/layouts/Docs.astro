---
import type { MarkdownHeading } from "astro";
import Icon from "../components/Icon.astro";
import { docHref, getDocSections, getSortedDocs } from "../lib/docs";
import { href, REPO_URL } from "../lib/site";
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  /** Collection id of the current page, or undefined for the docs overview. */
  id?: string;
  section?: string;
  headings?: MarkdownHeading[];
}

const { title, description, id, section, headings = [] } = Astro.props;
const sections = await getDocSections();
const ordered = await getSortedDocs();
const position = id ? ordered.findIndex((entry) => entry.id === id) : -1;
const previous = position > 0 ? ordered[position - 1] : undefined;
const next = id ? ordered[position + 1] : ordered[0];
const toc = headings.filter((heading) => heading.depth === 2);
const sourceUrl = id ? `${REPO_URL}/blob/main/website/src/content/docs/${id}.md` : undefined;
const currentLabel = ordered[position]?.data.navTitle ?? title;
---

<Base title={`${title} | Sentinel docs`} description={description} section="docs">
  <div class="wrap docs-shell">
    <aside class="docs-sidebar">
      <nav class="docs-nav docs-nav-desktop" aria-label="Documentation">
        <a class="docs-home" href={href("docs/")} aria-current={id ? undefined : "page"}>Overview</a>
        {
          sections.map((group) => (
            <div class="docs-group">
              <h2>{group.title}</h2>
              <ul>
                {group.entries.map((entry) => (
                  <li>
                    <a href={docHref(entry.id)} aria-current={entry.id === id ? "page" : undefined}>
                      {entry.data.navTitle ?? entry.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <details class="docs-menu">
        <summary>
          <span>Docs menu</span>
          <span class="docs-menu-current">{currentLabel}</span>
          <Icon name="caret-down" size={16} />
        </summary>
        <nav class="docs-nav" aria-label="Documentation">
          <a class="docs-home" href={href("docs/")} aria-current={id ? undefined : "page"}>Overview</a>
          {
            sections.map((group) => (
              <div class="docs-group">
                <h2>{group.title}</h2>
                <ul>
                  {group.entries.map((entry) => (
                    <li>
                      <a href={docHref(entry.id)} aria-current={entry.id === id ? "page" : undefined}>
                        {entry.data.navTitle ?? entry.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="docs-article">
      <header class="docs-header">
        <nav class="docs-breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={href("docs/")}>Docs</a></li>
            {section && <li aria-current="page">{section}</li>}
          </ol>
        </nav>
        <h1>{title}</h1>
        <p class="docs-description">{description}</p>
      </header>

      <div class="prose">
        <slot />
      </div>

      <footer class="docs-footer">
        {
          sourceUrl && (
            <a class="docs-source" href={sourceUrl}>
              <Icon name="github-logo" size={16} />
              View or improve this page on GitHub
            </a>
          )
        }
        <nav class="docs-pager" aria-label="Previous and next pages">
          {
            previous ? (
              <a class="pager-link" href={docHref(previous.id)} rel="prev">
                <span class="pager-direction">
                  <Icon name="arrow-left" size={14} />
                  Previous
                </span>
                <span class="pager-title">{previous.data.navTitle ?? previous.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="pager-link pager-next" href={docHref(next.id)} rel="next">
                <span class="pager-direction">
                  Next
                  <Icon name="arrow-right" size={14} />
                </span>
                <span class="pager-title">{next.data.navTitle ?? next.data.title}</span>
              </a>
            )
          }
        </nav>
      </footer>
    </article>

    {
      toc.length > 1 && (
        <aside class="docs-toc">
          <nav aria-labelledby="toc-title">
            <h2 id="toc-title">On this page</h2>
            <ul>
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 200px;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
    padding-top: clamp(32px, 5vw, 56px);
  }

  .docs-sidebar,
  .docs-toc {
    position: sticky;
    top: calc(var(--header-height) + 32px);
    max-height: calc(100dvh - var(--header-height) - 48px);
    overflow-y: auto;
    padding-bottom: 24px;
  }

  .docs-nav {
    display: grid;
    gap: 24px;
  }

  .docs-group h2,
  .docs-toc h2 {
    margin-bottom: 8px;
    color: var(--fg-subtle);
    font-size: 0.8125rem;
    font-weight: 550;
  }

  .docs-group ul,
  .docs-toc ul {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .docs-nav a {
    display: block;
    padding: 6px 10px;
    margin-left: -10px;
    border-radius: var(--radius-control);
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-decoration: none;
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .docs-nav a:hover {
    color: var(--fg);
  }

  .docs-nav a[aria-current="page"] {
    background: var(--signal-wash);
    color: var(--fg);
    box-shadow: inset 2px 0 0 var(--signal);
  }

  .docs-menu {
    display: none;
  }

  .docs-article {
    min-width: 0;
    max-width: 72ch;
  }

  .docs-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .docs-breadcrumbs li + li::before {
    content: "/";
    margin-right: 6px;
    color: var(--fg-subtle);
  }

  .docs-breadcrumbs a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  .docs-breadcrumbs a:hover {
    color: var(--fg);
  }

  .docs-header h1 {
    font-size: clamp(2rem, 1.5rem + 1.8vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.032em;
  }

  .docs-description {
    max-width: 60ch;
    margin-top: 14px;
    color: var(--fg-muted);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .docs-footer {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .docs-source {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .docs-source:hover {
    color: var(--fg);
  }

  .docs-pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
  }

  .pager-link {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-panel);
    text-decoration: none;
    transition: border-color 0.2s var(--ease-out);
  }

  .pager-link:hover {
    border-color: color-mix(in srgb, var(--signal) 55%, var(--line-strong));
  }

  .pager-next {
    text-align: right;
  }

  .pager-direction {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-muted);
    font-size: 0.8125rem;
  }

  .pager-next .pager-direction {
    justify-content: flex-end;
  }

  .pager-title {
    font-weight: 560;
  }

  .docs-toc ul {
    border-left: 1px solid var(--line);
  }

  .docs-toc a {
    display: block;
    padding: 5px 0 5px 14px;
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .docs-toc a:hover {
    color: var(--fg);
  }

  /* Rendered Markdown. */
  .prose {
    margin-top: 40px;
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .prose :global(> * + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 2.6em;
    padding-top: 1.4em;
    border-top: 1px solid var(--line);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .prose :global(h3) {
    margin-top: 2em;
    font-size: 1.125rem;
    font-weight: 590;
    letter-spacing: -0.01em;
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-top: 0.75em;
  }

  .prose :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--signal) 60%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--signal);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--fg-subtle);
  }

  .prose :global(code) {
    padding: 0.12em 0.36em;
    border-radius: 4px;
    background: var(--raised);
    color: var(--fg);
    font-size: 0.875em;
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--sunken) !important;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    overflow-wrap: normal;
  }

  .prose :global(kbd) {
    padding: 0.1em 0.4em;
    border: 1px solid var(--line-strong);
    border-bottom-width: 2px;
    border-radius: 4px;
    color: var(--fg);
    font-size: 0.85em;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 12px 16px;
    border-left: 2px solid var(--signal);
    border-radius: 0 var(--radius-panel) var(--radius-panel) 0;
    background: var(--panel);
    color: var(--fg);
  }

  .prose :global(blockquote > * + *) {
    margin-top: 0.6em;
  }

  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 20px 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    color: var(--fg);
    font-weight: 580;
    white-space: nowrap;
  }

  @media (max-width: 1199px) {
    .docs-shell {
      grid-template-columns: 220px minmax(0, 1fr);
    }

    .docs-toc {
      display: none;
    }
  }

  @media (max-width: 859px) {
    .docs-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 16px;
    }

    .docs-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      padding-bottom: 0;
    }

    .docs-nav-desktop {
      display: none;
    }

    .docs-menu {
      display: block;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-panel);
      background: var(--panel);
    }

    .docs-menu summary {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      padding: 0 14px;
      cursor: pointer;
      list-style: none;
      font-weight: 560;
    }

    .docs-menu summary::-webkit-details-marker {
      display: none;
    }

    .docs-menu-current {
      margin-left: auto;
      overflow: hidden;
      color: var(--fg-muted);
      font-weight: 400;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .docs-menu summary :global(svg) {
      flex: none;
      transition: transform 0.25s var(--ease-out);
    }

    .docs-menu[open] summary :global(svg) {
      transform: rotate(180deg);
    }

    .docs-menu .docs-nav {
      padding: 8px 14px 18px 24px;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 479px) {
    .docs-pager {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
