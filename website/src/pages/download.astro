---
import Download from "../components/Download.astro";
import ReleaseHistory from "../components/ReleaseHistory.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Download Sentinel for macOS, Windows and Linux"
  description="Get the latest Sentinel installer for your system, or any earlier version, with SHA-256 checksums."
>
  <section class="dl-hero">
    <div class="wrap">
      <span class="pill" data-reveal><span class="live-dot"></span>Installers for macOS, Windows and Linux</span>
      <h1 data-reveal style="--d:80ms">Get <span class="grad-text">Sentinel</span></h1>
      <p data-reveal style="--d:160ms">
        The latest version is picked for your system. Every installer comes with a SHA-256 checksum, and
        every earlier version stays one click away.
      </p>
    </div>
  </section>
  <Download />
  <ReleaseHistory />
</Base>

<style>
  .dl-hero {
    padding-block: clamp(56px, 8vw, 104px) 8px;
    text-align: center;
  }

  .dl-hero h1 {
    margin-top: 20px;
    font-size: clamp(2.5rem, 1.4rem + 4vw, 4.4rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .dl-hero p {
    max-width: 58ch;
    margin: 18px auto 0;
    color: var(--fg-muted);
    font-size: 1.125rem;
  }
</style>
