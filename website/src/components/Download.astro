---
import { OS_LABEL, type Os } from "../lib/platform";
import { ASSET_SPECS, type AssetKey } from "../lib/releases";
import { href, LATEST_RELEASE_URL } from "../lib/site";
import Icon from "./Icon.astro";

// Without JavaScript, or until GitHub answers, every link opens the latest release page.
const fallback = LATEST_RELEASE_URL;

const osOptions: { os: Os; icon: "apple-logo" | "windows-logo" | "linux-logo" }[] = [
  { os: "macos", icon: "apple-logo" },
  { os: "windows", icon: "windows-logo" },
  { os: "linux", icon: "linux-logo" },
];

interface Choice {
  key: AssetKey;
  label: string;
}

const panels: { os: Os; primary: Choice; secondary: Choice; note: string; armNote?: string }[] = [
  {
    os: "macos",
    primary: { key: "macos-arm64", label: "Download for Apple Silicon" },
    secondary: { key: "macos-x64", label: "Download for Intel" },
    note: "Not sure which Mac you have? Open the Apple menu and choose About This Mac. “Chip: Apple M…” means Apple Silicon, “Processor: Intel” means Intel. Requires macOS 11 or later.",
  },
  {
    os: "windows",
    primary: { key: "windows-x64-setup", label: "Download installer (.exe)" },
    secondary: { key: "windows-x64-msi", label: "MSI package" },
    note: "Windows 10 or 11, 64-bit. The .exe installs for your user account; the .msi suits managed or all-users installs.",
    armNote: "This looks like a Windows on Arm device. Sentinel ships an x64 build, which Windows 11 runs under emulation.",
  },
  {
    os: "linux",
    primary: { key: "linux-x64-appimage", label: "Download AppImage" },
    secondary: { key: "linux-x64-deb", label: ".deb for Debian and Ubuntu" },
    note: "64-bit x86 only. The AppImage runs on most distributions; the install guide lists the WebKitGTK packages the .deb depends on.",
    armNote: "This looks like an Arm device. Sentinel currently ships Linux builds for x86-64 only.",
  },
];
---

<section id="download" class="download" aria-labelledby="download-title">
  <div class="wrap">
    <div class="download-grid" data-download>
      <div class="download-intro">
        <h2 id="download-title" class="section-title">Download Sentinel</h2>
        <p class="section-lede">
          One app for macOS, Windows and Linux. Install it, grant the permissions you're comfortable
          with, and it starts reading your system right away.
        </p>
        <p class="release-status" role="status" data-release-status data-state="loading">
          <span class="status-dot" aria-hidden="true"></span>
          <span data-release-message>Looking up the latest release on GitHub.</span>
        </p>
      </div>

      <div class="download-panel">
        <fieldset class="os-picker">
          <legend>Show downloads for</legend>
          <div class="os-options">
            {
              osOptions.map(({ os, icon }) => (
                <label class="os-option">
                  <input type="radio" name="download-os" value={os} checked={os === "macos"} />
                  <Icon name={icon} size={18} />
                  <span>{OS_LABEL[os]}</span>
                  <span class="detected-tag" data-detected-tag={os} hidden>
                    Your system
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        {
          panels.map((panel) => (
            <div class="os-panel" data-os-panel={panel.os}>
              <div class="choice-row" data-choice-row>
                <a
                  class="btn btn-primary btn-large"
                  href={fallback}
                  data-asset={panel.primary.key}
                  data-choice="primary"
                >
                  <Icon name="download-simple" />
                  <span>{panel.primary.label}</span>
                </a>
                <a
                  class="btn btn-secondary btn-large"
                  href={fallback}
                  data-asset={panel.secondary.key}
                  data-choice="secondary"
                >
                  <span>{panel.secondary.label}</span>
                </a>
              </div>
              <p class="choice-sizes mono" data-choice-sizes hidden />
              <p class="panel-note">{panel.note}</p>
              {panel.armNote && (
                <p class="panel-note panel-note-warn" data-arm-note hidden>
                  <Icon name="info" size={16} />
                  <span>{panel.armNote}</span>
                </p>
              )}
            </div>
          ))
        }

        <p class="panel-note" data-unsupported-note hidden>
          Sentinel is a desktop app. Open this page on the Mac or PC you want to monitor, or pick
          its system above.
        </p>
      </div>
    </div>

    <div class="all-downloads">
      <h3 class="all-title">All downloads</h3>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th scope="col">System</th>
              <th scope="col">Format</th>
              <th scope="col">File</th>
              <th scope="col" class="size-col">Size</th>
            </tr>
          </thead>
          <tbody>
            {
              ASSET_SPECS.map((spec) => (
                <tr>
                  <td>
                    {OS_LABEL[spec.os]} {spec.label}
                  </td>
                  <td>{spec.format}</td>
                  <td>
                    <a class="file-link mono" href={fallback} data-asset={spec.key} data-asset-name>
                      Sentinel-x.y.z{spec.suffix}
                    </a>
                  </td>
                  <td class="size-col mono" data-asset-size={spec.key} />
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="downloads-links">
        <a class="text-link" href={fallback} data-checksums>SHA-256 checksums</a>
        <a class="text-link" href={fallback} data-release-page>Release notes</a>
        <a class="text-link" href={href("docs/install/")}>Install guide</a>
      </p>
    </div>
  </div>
</section>

<script>
  import { detectPlatform, OS_LABEL, type Os } from "../lib/platform";
  import {
    ASSET_SPECS,
    assetFileName,
    formatBytes,
    lookupLatestRelease,
    type LatestRelease,
  } from "../lib/releases";

  const root = document.querySelector<HTMLElement>("[data-download]");
  const section = document.getElementById("download");

  if (root && section) {
    const radios = Array.from(root.querySelectorAll<HTMLInputElement>('input[name="download-os"]'));
    let userPicked = false;
    for (const radio of radios) radio.addEventListener("change", () => (userPicked = true));

    void detectPlatform()
      .then(({ os, arch }) => applyDetection(root, radios, os, arch, userPicked))
      .catch(() => {
        // Keep the default selection if detection throws.
      });

    void lookupLatestRelease().then((result) => {
      const status = root.querySelector<HTMLElement>("[data-release-status]");
      const message = root.querySelector<HTMLElement>("[data-release-message]");
      if (!status || !message) return;

      if (result.status === "found") {
        applyRelease(section, result.release);
        status.dataset.state = "found";
        message.textContent = describeRelease(result.release);
      } else if (result.status === "none") {
        status.dataset.state = "fallback";
        message.textContent =
          "No release has been published yet. The download links open the GitHub releases page, where installers will appear once the first version ships.";
      } else {
        status.dataset.state = "fallback";
        message.textContent = `Release details couldn't be loaded because ${result.reason}. The download links open the latest release page on GitHub instead, where you can pick your file.`;
      }
    });
  }

  function applyDetection(
    root: HTMLElement,
    radios: HTMLInputElement[],
    os: Os | null,
    arch: "arm64" | "x64" | null,
    userPicked: boolean,
  ) {
    if (!os) {
      root.querySelector<HTMLElement>("[data-unsupported-note]")?.removeAttribute("hidden");
      return;
    }
    const radio = radios.find((candidate) => candidate.value === os);
    if (radio && !userPicked) radio.checked = true;
    root.querySelector<HTMLElement>(`[data-detected-tag="${os}"]`)?.removeAttribute("hidden");

    const panel = root.querySelector<HTMLElement>(`[data-os-panel="${os}"]`);
    if (!panel) return;
    if (os === "macos" && arch === "x64") {
      // Chromium reports an Intel Mac: make the Intel build the prominent button.
      panel.querySelector('[data-choice="primary"]')?.classList.replace("btn-primary", "btn-secondary");
      panel.querySelector('[data-choice="secondary"]')?.classList.replace("btn-secondary", "btn-primary");
      panel.querySelector("[data-choice-row]")?.classList.add("is-reversed");
    }
    if (os !== "macos" && arch === "arm64") {
      panel.querySelector<HTMLElement>("[data-arm-note]")?.removeAttribute("hidden");
    }
    root.querySelector(`[data-detected-tag="${os}"]`)?.setAttribute("aria-label", `Detected: ${OS_LABEL[os]}`);
  }

  function applyRelease(section: HTMLElement, release: LatestRelease) {
    for (const spec of ASSET_SPECS) {
      const asset = release.assets[spec.key];
      for (const link of section.querySelectorAll<HTMLAnchorElement>(`a[data-asset="${spec.key}"]`)) {
        link.href = asset?.url ?? release.pageUrl;
        if ("assetName" in link.dataset) link.textContent = asset?.name ?? assetFileName(release.version, spec);
      }
      const size = section.querySelector<HTMLElement>(`[data-asset-size="${spec.key}"]`);
      if (size) size.textContent = asset ? formatBytes(asset.size) : "Not uploaded";
    }

    for (const panel of section.querySelectorAll<HTMLElement>("[data-os-panel]")) {
      const sizes = panel.querySelector<HTMLElement>("[data-choice-sizes]");
      const labels = Array.from(panel.querySelectorAll<HTMLAnchorElement>("a[data-asset]"))
        .map((link) => {
          const spec = ASSET_SPECS.find((candidate) => candidate.key === link.dataset.asset);
          const asset = spec ? release.assets[spec.key] : undefined;
          return spec && asset ? `${spec.label} ${formatBytes(asset.size)}` : null;
        })
        .filter((label): label is string => label !== null);
      if (sizes && labels.length > 0) {
        sizes.textContent = `Sentinel ${release.version}: ${labels.join(", ")}`;
        sizes.hidden = false;
      }
    }

    const checksums = section.querySelector<HTMLAnchorElement>("[data-checksums]");
    if (checksums) {
      if (release.checksums) checksums.href = release.checksums.url;
      else checksums.hidden = true;
    }
    const page = section.querySelector<HTMLAnchorElement>("[data-release-page]");
    if (page) page.href = release.pageUrl;
  }

  function describeRelease(release: LatestRelease): string {
    const published = release.publishedAt
      ? new Intl.DateTimeFormat(undefined, { dateStyle: "long" }).format(new Date(release.publishedAt))
      : null;
    const missing = ASSET_SPECS.filter((spec) => !release.assets[spec.key]).length;
    const base = published
      ? `Latest release: Sentinel ${release.version}, published ${published}.`
      : `Latest release: Sentinel ${release.version}.`;
    return missing > 0
      ? `${base} ${missing} of ${ASSET_SPECS.length} files aren't attached yet; those links open the release page.`
      : base;
  }
</script>

<style>
  .download {
    padding-block: clamp(56px, 9vw, 120px) 0;
    border-top: 1px solid var(--line);
  }

  .download-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .release-status {
    display: flex;
    gap: 10px;
    max-width: 52ch;
    margin-top: 28px;
    color: var(--fg-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .status-dot {
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: 0.5em;
    border-radius: 50%;
    background: var(--fg-subtle);
  }

  .release-status[data-state="found"] .status-dot {
    background: var(--signal);
  }

  .release-status[data-state="fallback"] .status-dot {
    background: var(--warn);
  }

  @media (prefers-reduced-motion: no-preference) {
    .release-status[data-state="loading"] .status-dot {
      animation: status-wait 1.2s ease-in-out infinite alternate;
    }
  }

  @keyframes status-wait {
    to {
      opacity: 0.25;
    }
  }

  .download-panel {
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-dialog);
    background: var(--panel);
    box-shadow: var(--shadow-raised);
  }

  .os-picker {
    margin: 0 0 28px;
    padding: 0;
    border: 0;
  }

  .os-picker legend {
    margin-bottom: 10px;
    padding: 0;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .os-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-panel);
    background: var(--sunken);
  }

  .os-option {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2px 8px;
    min-height: 44px;
    padding: 6px 8px;
    border-radius: var(--radius-control);
    color: var(--fg-muted);
    font-size: 0.9375rem;
    font-weight: 550;
    cursor: pointer;
    transition:
      color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }

  .os-option input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .os-option:hover {
    color: var(--fg);
  }

  .os-option:has(input:checked) {
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    color: var(--fg);
  }

  .os-option:has(input:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }

  .detected-tag {
    flex-basis: 100%;
    color: var(--signal);
    font-size: 0.6875rem;
    font-weight: 550;
    text-align: center;
  }

  /* The selected radio decides which panel shows, so switching works without JavaScript. */
  .os-panel {
    display: none;
  }

  .download-panel:has(input[value="macos"]:checked) [data-os-panel="macos"],
  .download-panel:has(input[value="windows"]:checked) [data-os-panel="windows"],
  .download-panel:has(input[value="linux"]:checked) [data-os-panel="linux"] {
    display: block;
  }

  .choice-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .choice-row.is-reversed {
    flex-direction: row-reverse;
    justify-content: flex-end;
  }

  .choice-row .btn-primary {
    flex: 1 1 260px;
  }

  .choice-row .btn-secondary {
    flex: 0 1 auto;
  }

  .choice-sizes {
    margin-top: 12px;
    color: var(--fg-subtle);
    font-size: 0.8125rem;
  }

  .panel-note {
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .panel-note-warn {
    display: flex;
    gap: 8px;
    padding: 10px 12px;
    border-radius: var(--radius-panel);
    background: color-mix(in srgb, var(--warn) 10%, transparent);
    color: var(--fg);
  }

  .panel-note-warn :global(svg) {
    flex: none;
    margin-top: 0.2em;
    color: var(--warn);
  }

  .all-downloads {
    margin-top: clamp(48px, 7vw, 88px);
  }

  .all-title {
    font-size: 1.0625rem;
    font-weight: 580;
  }

  .table-scroll {
    margin-top: 16px;
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th,
  td {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: baseline;
  }

  th {
    color: var(--fg-subtle);
    font-size: 0.8125rem;
    font-weight: 550;
  }

  td {
    color: var(--fg-muted);
  }

  td:first-child {
    color: var(--fg);
  }

  .size-col {
    padding-right: 0;
    text-align: right;
    white-space: nowrap;
  }

  td.size-col {
    font-size: 0.8125rem;
  }

  .file-link {
    color: var(--fg);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .file-link:hover {
    text-decoration-color: var(--signal);
  }

  .downloads-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 20px;
    font-size: 0.9375rem;
  }

  .downloads-links a[hidden] {
    display: none;
  }

  @media (max-width: 899px) {
    .download-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 479px) {
    .os-option span:not(.detected-tag) {
      font-size: 0.875rem;
    }

    .choice-row .btn {
      flex: 1 1 100%;
    }
  }
</style>
