---
// Simplified from the app icon (src-tauri/icons/source.svg): two range rings, a live arc, a signal dot.
interface Props {
  size?: number;
}

const { size = 24 } = Astro.props;
---

<svg
  class="logo"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke-linecap="round" stroke-width="1.6">
    <circle cx="12" cy="12" r="9.2" stroke="var(--signal)" stroke-opacity="0.22"></circle>
    <circle cx="12" cy="12" r="5.6" stroke="var(--signal)" stroke-opacity="0.42"></circle>
    <path d="M12 2.8A9.2 9.2 0 0 1 21.2 12" stroke="var(--signal)" stroke-width="2.2"></path>
  </g>
  <circle cx="12" cy="12" r="2" fill="var(--signal)"></circle>
</svg>
