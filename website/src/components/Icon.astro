---
import { ICONS, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Accessible name. Omit for decorative icons next to visible text. */
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  focusable="false"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}><path d={ICONS[name]}></path></svg>
