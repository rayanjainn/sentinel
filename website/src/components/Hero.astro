---
import { href } from "../lib/site";
import Capture from "./Capture.astro";
import Icon from "./Icon.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">
        See everything running on your machine and control it in plain English.
      </h1>
      <p class="hero-lede">
        Sentinel is a desktop app for macOS, Windows and Linux. It shows live processes, ports and
        connections, CPU, memory and disk usage, and lets you act on any of them. Ask its agent to
        free a port or clear space, and it checks the real state of your system, then lays out each
        step for you to approve before anything runs.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-large" href={href("#download")}>
          <Icon name="download-simple" />
          <span data-hero-download-label>Download Sentinel</span>
        </a>
        <a class="btn btn-secondary btn-large" href={href("docs/getting-started/")}>
          Read the guide
        </a>
      </div>
      <p class="hero-platforms">
        For macOS 11 or later on Apple Silicon and Intel, Windows 10 and 11, and 64-bit Linux.
      </p>
    </div>

    <div class="hero-shot">
      <Capture
        title="Sentinel"
        shot="Main window in the dark theme: Network view with the world map of live connections, and the agent panel docked on the right showing a plan card. Captured at 1440 x 920."
      />
    </div>
  </div>
</section>

<script>
  import { detectPlatform, OS_LABEL } from "../lib/platform";

  const label = document.querySelector("[data-hero-download-label]");
  detectPlatform()
    .then(({ os }) => {
      if (label && os) label.textContent = `Download for ${OS_LABEL[os]}`;
    })
    .catch(() => {
      // Detection is a nicety; the generic label stays.
    });
</script>

<style>
  .hero {
    overflow-x: clip;
    padding-block: clamp(48px, 9vw, 112px) clamp(56px, 8vw, 104px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    row-gap: clamp(40px, 6vw, 72px);
  }

  .hero-copy {
    grid-column: 1 / span 8;
  }

  .hero-title {
    max-width: 19ch;
    font-size: clamp(2.375rem, 1.1rem + 4.4vw, 4.5rem);
    font-weight: 620;
    line-height: 1.02;
    letter-spacing: -0.042em;
  }

  .hero-lede {
    max-width: 54ch;
    margin-top: 28px;
    color: var(--fg-muted);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero-platforms {
    margin-top: 18px;
    color: var(--fg-subtle);
    font-size: 0.875rem;
  }

  /* The capture starts a third of the way in and runs off the right edge of the viewport. */
  .hero-shot {
    grid-column: 4 / -1;
    margin-right: calc(-1 * var(--gutter) - max(0px, (100vw - var(--max-width) - var(--gutter) * 2) / 2) - 96px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-title,
    .hero-lede,
    .hero-actions,
    .hero-platforms,
    .hero-shot {
      animation: hero-rise 0.9s var(--ease-out) both;
    }

    .hero-lede {
      animation-delay: 0.08s;
    }

    .hero-actions {
      animation-delay: 0.16s;
    }

    .hero-platforms {
      animation-delay: 0.22s;
    }

    .hero-shot {
      animation-duration: 1.2s;
      animation-delay: 0.3s;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @media (max-width: 1023px) {
    .hero-copy {
      grid-column: 1 / -1;
    }

    .hero-shot {
      grid-column: 2 / -1;
    }
  }

  @media (max-width: 767px) {
    .hero-shot {
      grid-column: 1 / -1;
      margin-right: 0;
    }

    .hero-actions .btn {
      flex: 1 1 220px;
    }
  }
</style>
